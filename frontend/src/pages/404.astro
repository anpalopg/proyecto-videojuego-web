---
import Layout from '../components/Layout.astro';
---

<Layout title="404 — Recessed Minds">
  <main class="not-found">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">Ruta no encontrada</h1>
    <p class="not-found__desc">
      Esta realidad no existe… o quizás nunca existió.
    </p>
    <a href="/" class="not-found__btn">Volver al inicio</a>
  </main>
</Layout>

<style>
  .not-found {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    background:
      radial-gradient(ellipse 60% 50% at 50% 40%, var(--violet) 0%, transparent 70%),
      var(--black);
  }

  .not-found__code {
    font-family: var(--font-tech);
    font-size: clamp(6rem, 20vw, 14rem);
    font-weight: 900;
    color: var(--red-bright);
    line-height: 1;
    letter-spacing: -0.02em;
    text-shadow: 0 0 40px var(--glow-red);
  }

  .not-found__title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 3vw, 1.8rem);
    font-weight: 600;
    color: var(--beige);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-top: 0.5rem;
  }

  .not-found__desc {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--beige-dim);
    margin-top: 1rem;
    max-width: 36ch;
    line-height: 1.6;
  }

  .not-found__btn {
    margin-top: 2.5rem;
    display: inline-block;
    padding: 0.75rem 2rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--beige);
    border: 1px solid var(--red-bright);
    background: transparent;
    transition: background 0.2s, color 0.2s;
  }

  @media (hover: hover) {
    .not-found__btn:hover {
      background: var(--red-bright);
      color: var(--beige);
    }
  }
</style>
